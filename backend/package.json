{
  "name": "smart-transport-backend",
  "private": true,
  "type": "module",
  "description": "Servidor intermedio entre la app y la API Transporte del GCBA",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "check-api": "node --env-file-if-exists=.env scripts/check-api.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
