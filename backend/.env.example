# Credenciales de la API Transporte del GCBA (colectivos y subte).
# Pedilas en https://api-transporte.buenosaires.gob.ar/registro
# Si quedan vacías, colectivos y subte arrancan en MODO DEMO con datos simulados.
TRANSPORTE_CLIENT_ID=
TRANSPORTE_CLIENT_SECRET=

# Ecobici usa el feed GBFS público del operador (no necesita credenciales).
# "demo" usa datos simulados, útil para trabajar sin internet.
ECOBICI_SOURCE=live
# ECOBICI_GBFS_URL=https://buenosaires.publicbikesystem.net/customer/gbfs/v2/gbfs.json

# Puerto HTTP del servidor
PORT=8080
